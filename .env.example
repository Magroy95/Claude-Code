# Kopiere diese Datei nach .env.local und trage deine echten Werte ein.
# .env.local wird nie eingecheckt (siehe .gitignore).

# Anthropic API-Key für die Analyse-Pipeline (console.anthropic.com)
ANTHROPIC_API_KEY=

# Für lokale Entwicklung ist DATABASE_URL bereits in .env gesetzt.
# Für ein Deployment hier die produktive Postgres-Verbindung eintragen.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Basisverzeichnis für lokal gespeicherte Uploads (Exposés, Fotos, Dokumente)
UPLOADS_DIR=./uploads

# Optional: Häuserpreisindex des Statistischen Bundesamts (Destatis) als
# zusätzliche Markteinordnung für den marktwertAgent. Kostenloses Konto unter
# https://www-genesis.destatis.de/genesis/online → "Anmelden". Ohne diese
# Werte läuft die Analyse unverändert weiter, nur ohne diesen Zusatzhinweis.
# Siehe README, Abschnitt "Marktdaten-Quellen verifizieren".
DESTATIS_GENESIS_USERNAME=
DESTATIS_GENESIS_PASSWORD=
# Nur setzen, falls die im Code hinterlegte Tabellen-Kennung (Platzhalter,
# siehe lib/analysis/marktdaten/destatis.ts) sich als falsch herausstellt.
# DESTATIS_TABELLE_HAEUSERPREISINDEX=
