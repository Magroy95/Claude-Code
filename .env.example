# --- Datenbank ---
DATABASE_URL="postgresql://user:passwort@host:5432/hauskaufchecker?schema=public"

# --- Analyse ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Öffentliche Adresse (für Links in Mails und Metadaten) ---
NEXT_PUBLIC_SITE_URL="https://hauskaufchecker.de"

# --- Anbieterangaben für Impressum, AGB und Widerruf ---
# Ohne ladungsfähige Anschrift ist das Impressum unvollständig (§ 5 DDG).
ANBIETER_NAME=""
ANBIETER_STRASSE=""
ANBIETER_PLZ_ORT=""
ANBIETER_EMAIL=""
ANBIETER_VERANTWORTLICH=""

# --- Mailversand (Brevo, EU) ---
BREVO_API_KEY=""
MAIL_ABSENDER="noreply@hauskaufchecker.de"

# --- Zahlung (Stripe) ---
STRIPE_SECRET_KEY=""
# Signaturgeheimnis des Webhooks; ohne dieses werden Zahlungen nicht verbucht.
STRIPE_WEBHOOK_SECRET=""

# --- PDF-Export ---
# Signiert das kurzlebige Token, mit dem sich der druckende Browser
# gegenüber der Reportseite ausweist. Beliebiges langes Geheimnis.
PDF_TOKEN_SECRET=""

# --- Öffentlicher Beispielreport ---
# ID der Analyse, auf die /beispielreport zeigt. Sie muss fertig,
# freigeschaltet und keinem Konto zugeordnet sein und darf nur zu einem als
# fiktiv gekennzeichneten Exposé gehören – ein Report nennt Adresse, Preis
# und vermutete Mängel, das gehört bei einem realen Objekt nicht ins Netz.
# Vorlage: scripts/musterexpose.html, Einrichtung:
# npx tsx --env-file=.env scripts/beispielreport-setzen.mts <ID>
BEISPIEL_ANALYSE_ID=""

# --- Löschlauf ---
# Beliebiges langes Geheimnis; schützt /api/cron/loeschung.
CRON_SECRET=""

# --- Auswertung im Hintergrund ---
# Gemeinsames Geheimnis zwischen Upload und Auswertungsroute. Ohne dieses
# laeuft die Pipeline im aufrufenden Prozess weiter und wird auf Netlify
# nicht fertig. Beliebiger langer Zufallswert.
PIPELINE_SECRET=""

# --- Dateiablage ---
# Auf Netlify wird automatisch Netlify Blobs verwendet (erkannt an der von
# der Plattform gesetzten Variable NETLIFY). Lokal das Verzeichnis unten.
# STORAGE_ADAPTER="lokal" | "netlify" erzwingt die Auswahl.
UPLOADS_DIR="./uploads"

# Nur noetig, wenn von ausserhalb der Netlify-Laufzeit auf die Ablage
# zugegriffen wird (z.B. ein lokaler Skriptlauf gegen die Produktivdaten).
NETLIFY_SITE_ID=""
NETLIFY_BLOBS_TOKEN=""

# Pfad zu einem lokal installierten Chromium fuer den PDF-Export.
# In der Netlify-Laufzeit wird stattdessen @sparticuz/chromium verwendet.
CHROMIUM_PFAD="/opt/pw-browsers/chromium-1194/chrome-linux/chrome"
